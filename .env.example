# Copy to .env.local and fill in. .env.local is gitignored.
AUTH_SECRET=                 # long random string, e.g. `openssl rand -base64 32`
# Hosted database (Neon). Leave blank on your own computer to keep using the data/db.json file. REQUIRED on Vercel.
DATABASE_URL=                # starts with postgresql://, from neon.tech (or Vercel Storage > Neon)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=      # only used the first time, to create the admin account

# Send Class Email uses Resend (resend.com). Leave blank until you're ready, then fill both in.
RESEND_API_KEY=              # your Resend API key, starts with re_
RESEND_FROM_EMAIL=           # a sender on a domain you verified in Resend, e.g. NextGen Coders <hello@yourdomain.org>
